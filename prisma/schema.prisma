generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String
  snippets  Snippet[]
  comments  Comment[]
  createdAt DateTime  @default(now())
}

model Snippet {
  id           String    @id
  description  String?
  isSecret     Boolean   @default(false)
  userId       String?
  user         User?     @relation(fields: [userId], references: [id])
  forkedFromId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  comments     Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  snippetId String
  userId    String?
  guestName String?
  content   String
  createdAt DateTime @default(now())
  snippet   Snippet  @relation(fields: [snippetId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])
}
