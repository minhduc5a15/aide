generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String
  bio       String?
  location  String?
  website   String?
  snippets  Snippet[]
  comments  Comment[]
  stars     Star[]
  createdAt DateTime  @default(now())
}

model Snippet {
  id           String    @id
  description  String?
  isSecret     Boolean   @default(false)
  userId       String?
  user         User?     @relation(fields: [userId], references: [id])
  forkedFromId String?
  forkedFrom   Snippet?  @relation("Forks", fields: [forkedFromId], references: [id])
  forks        Snippet[] @relation("Forks")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  comments     Comment[]
  stars        Star[]
  files        File[]

  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Comment {
  id        String   @id @default(cuid())
  snippetId String
  userId    String?
  guestName String?
  content   String
  createdAt DateTime @default(now())
  snippet   Snippet  @relation(fields: [snippetId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])
}

model Star {
  id        String   @id @default(cuid())
  userId    String
  snippetId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  snippet   Snippet  @relation(fields: [snippetId], references: [id], onDelete: Cascade)

  @@unique([userId, snippetId])
}

model File {
  id        String  @id @default(cuid())
  snippetId String
  name      String
  content   String
  snippet   Snippet @relation(fields: [snippetId], references: [id], onDelete: Cascade)

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
}
